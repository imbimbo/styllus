---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/react/SiteHeader';
import IntentPicker from '../components/react/IntentPicker';
import PlanQuiz from '../components/react/PlanQuiz';
import PlanIcon from '../components/PlanIcon.astro';
import ContactForm from '../components/react/ContactForm';
import Testimonials from '../components/react/Testimonials';
import HeroActions from '../components/react/HeroActions';
import googleReviews from '../data/google-reviews.json';
import { withBase } from '../lib/base';

const googleRating = googleReviews.rating.toFixed(1);

const services = [
  {
    label: 'Assessoria Tributária',
    title: 'Revisão do que a empresa já paga, dentro da lei.',
    bullets: ['Apuração do imposto devido', 'Revisões e oportunidades fiscais', 'Calendário fiscal sem surpresas'],
    practice: 'Na prática: planejamento tributário, análise de NCM, apuração de impostos e obrigações acessórias.',
  },
  {
    label: 'Assessoria Trabalhista',
    title: 'Folha, admissões e eSocial no prazo, todo mês.',
    bullets: ['eSocial sem pendências', 'Rotinas claras e prazos cumpridos', 'Orientação preventiva para o RH'],
    practice: 'Na prática: folha, admissões, demissões e rotinas do departamento pessoal.',
  },
  {
    label: 'Assessoria Contábil',
    title: 'Balanço e relatório que mostram o resultado do mês.',
    bullets: ['Demonstrativos e indicadores-chave', 'Centros de custo e orçamentos', 'Acompanhamento consultivo com analistas experientes'],
    practice: 'Na prática: escrituração, balanços e relatórios gerenciais que viram decisões.',
  },
  {
    label: 'BPO Financeiro',
    title: 'Deixe a rotina financeira com a gente e volte a olhar para o negócio.',
    bullets: ['Rotina financeira organizada', 'DRE gerencial e previsões', 'Painéis e relatórios de controle'],
    practice: 'Na prática: contas a pagar e receber, conciliações e fluxo de caixa.',
  },
];

const plans = [
  {
    name: 'Bronze',
    badge: 'Tributário',
    featured: false,
    price: 'A partir de R$ 250',
    description: 'O tributário em dia. Ponto de partida para a empresa que precisa de imposto certo.',
    items: ['Apuração de impostos', 'Obrigações fiscais', 'Analista dedicado'],
  },
  {
    name: 'Prata',
    badge: '+ Departamento pessoal',
    featured: false,
    price: 'A partir de R$ 400',
    description: 'O Bronze, mais o departamento pessoal.',
    items: ['Tudo do Bronze', 'Folha de pagamento', 'Admissões e demissões', 'eSocial'],
  },
  {
    name: 'Ouro',
    badge: 'Para a PME',
    featured: true,
    price: 'A partir de R$ 700',
    description: 'O Prata, mais a contabilidade para decidir todo mês.',
    items: ['Tudo do Prata', 'Balanços e demonstrativos', 'Relatórios gerenciais', 'Acompanhamento consultivo'],
  },
  {
    name: 'Premium',
    badge: '+ BPO financeiro',
    featured: false,
    price: 'A partir de R$ 1.100',
    description: 'O Ouro, mais a rotina financeira nas mãos da Styllu\'s.',
    items: ['Tudo do Ouro', 'Contas a pagar e receber', 'Conciliações bancárias', 'Fluxo de caixa'],
  },
];

const priceFactors = ['Regime tributário', 'Faturamento', 'Funcionários', 'Filiais', 'Folha', 'BPO financeiro'];

const team = [
  {
    initials: 'EM',
    photo: 'emerson-morelli.jpg',
    name: 'Emerson Morelli',
    role: 'Diretor e Gerente Tributário',
    bio: 'No tributário da Styllu\'s desde 2014. ICMS, substituição tributária, PIS e COFINS: é quem confere se a empresa paga o que deve, nem mais, nem menos. Conhecido pelos clientes pelo retorno rápido e pela explicação simples.',
  },
  {
    initials: 'FR',
    photo: 'felipe-rinaldi.jpg',
    name: 'Felipe Rinaldi',
    role: 'Diretor Estratégico',
    bio: 'Segunda geração da família Rinaldi. Começou como auxiliar fiscal, passou pelo tributário e hoje é diretor estratégico. Criou o processo de entrada de novos clientes e defende que contabilidade não é custo, é investimento.',
  },
];

const milestones = [
  {
    year: '1990',
    text: 'Um quarto na Nossa Senhora do Ó, uma máquina de escrever e os primeiros clientes. Um deles, o Açougue Guaraci, continua com a gente até hoje.',
  },
  {
    year: '1993',
    text: 'Rua Cajati e o primeiro computador. A máquina de escrever começa a se aposentar.',
  },
  {
    year: '1998',
    text: 'A crise da Rússia chega ao Brasil, os juros passam de 40% ao ano e o país recorre ao FMI. No meio da turbulência, chega a Zilma, que gerenciou o escritório por 17 anos.',
  },
  {
    year: '2010',
    text: 'Depois de quase dez endereços, dois deles em cima de padaria e um onde chovia mais dentro do que fora, a casa própria na Rua da Bica. Dez pessoas e nenhum proprietário para pedir o imóvel de volta.',
  },
  {
    year: '2025',
    text: '35 anos depois, um novo capítulo: rebranding, logotipo novo e uma mudança de mentalidade e de postura, de dentro para fora. O jeito de atender, perto do cliente, continua o mesmo.',
  },
];
---

<BaseLayout>
  <SiteHeader client:load />

  <main>
    <section class="hero">
      <div class="container hero__grid">
        <div class="fade-up">
          <div class="hero__badge">PME no Simples ou no Lucro Presumido • Analista dedicado</div>
          <h1>
            Pague o que é devido,
            <span>nem um real além disso.</span>
          </h1>
          <p class="hero__tagline">Assessoria de perto, do primeiro CNPJ à empresa com equipe.</p>
          <p class="hero__lead">
            Tributos, folha e números com um analista que conhece a empresa pelo nome. A partir de R$ 250,00. Para quem abre a empresa e fecha contrato, o primeiro honorário sai grátis.
          </p>
          <HeroActions client:load />
          <div class="hero__stats">
            <div>
              <div class="stat-number">1990</div>
              <div class="stat-label">Açougue Guaraci, cliente desde então</div>
            </div>
            <div>
              <div class="stat-number text-gold-shine">{googleRating}★</div>
              <div class="stat-label">{googleReviews.total} avaliações no Google</div>
            </div>
            <div>
              <div class="stat-number">0</div>
              <div class="stat-label">Reclamações no Reclame Aqui</div>
            </div>
          </div>
        </div>
        <div class="hero__visual fade-up-delay">
          <div class="hero__logo-wrap">
            <img src={withBase('styllu-logo.png')} alt="Styllu's Assessoria Contábil" width="320" height="320" />
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="comece">
      <div class="container">
        <p class="eyebrow">Comece por aqui</p>
        <h2 class="section-title">O que trouxe você até a Styllu's?</h2>
        <p class="section-lead">
          Escolha o que mais se parece com o seu momento. Algumas perguntas rápidas e um especialista fala com você.
        </p>
        <IntentPicker client:visible />
      </div>
    </section>

    <section class="section section-alt" id="servicos">
      <div class="container">
        <p class="eyebrow">Assessorias</p>
        <h2 class="section-title">O que você ganha com as nossas assessorias</h2>
        <p class="section-lead">Tributário, folha, contábil e BPO. A PME escolhe até onde a Styllu's entra.</p>
        <div class="grid-2">
          {services.map((service) => (
            <article class="feature-tile">
              <p class="service-label">{service.label}</p>
              <h3>{service.title}</h3>
              <ul>
                {service.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <p>{service.practice}</p>
            </article>
          ))}
        </div>
        <p class="section-footnote">
          Suporte consultivo sempre que precisar • Tempo médio de resposta: até 24h úteis
        </p>
      </div>
    </section>

    <section class="section" id="sobre">
      <div class="container about-block">
        <div class="about-copy">
          <p class="eyebrow">Sobre</p>
          <h2 class="section-title">Conheça a Styllu's Assessoria Contábil</h2>
          <p>
            São <strong>35 anos</strong> de história construída cliente a cliente, conversa por conversa. Começamos como um pequeno escritório de contabilidade em São Paulo e crescemos com uma convicção simples: o cliente não precisa entender de tributo, precisa de alguém de confiança para cuidar disso por ele.
          </p>
          <p>
            Hoje somos um time de analistas, gestores e parceiros, diretores como o <strong>Emerson Morelli</strong>, o <strong>Felipe Rinaldi</strong> e muitos outros líderes e colaboradores, que os clientes chamam pelo nome porque a relação é assim: próxima, atenta, presente no mês inteiro, não só no fechamento.
          </p>
          <blockquote class="about-quote">
            “Numa época em que tudo era escritório, a ideia era ser assessoria.”
          </blockquote>
          <a class="btn btn-primary" href="https://wa.me/5511925188621?text=Ol%C3%A1!%20Quero%20falar%20com%20um%20especialista%20sobre%20a%20minha%20empresa." target="_blank" rel="noopener noreferrer">Falar com especialista</a>
        </div>
        <div>
          <div class="mission-grid">
            <article class="mission-card">
              <h3>Missão</h3>
              <p>Ressignificar a contabilidade com uma assessoria humanizada, prática e personalizada.</p>
            </article>
            <article class="mission-card">
              <h3>Visão</h3>
              <p>Ser referência nacional em assessoria consultiva reconhecida pela excelência no atendimento.</p>
            </article>
          </div>
          <div class="hero__stats hero__stats--compact">
            <div>
              <div class="stat-number">35+</div>
              <div class="stat-label">Anos de história</div>
            </div>
            <div>
              <div class="stat-number">400+</div>
              <div class="stat-label">Clientes ativos</div>
            </div>
          </div>
        </div>
      </div>

      <div class="container history">
        <div class="history__intro">
          <figure class="history__photo">
            <img
              src={withBase('mauro-roseli-rinaldi-35-anos.jpg')}
              alt="Mauro e Roseli Rinaldi, fundadores da Styllu's, na comemoração de 35 anos do escritório"
              width="803"
              height="1024"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Mauro e Roseli Rinaldi, fundadores</figcaption>
          </figure>
          <div class="history__copy">
            <p class="eyebrow">Nossa história</p>
            <h2 class="section-title">Um novo estilo de contabilidade. Desde 1990.</h2>
            <p>
              Em maio de 1990, quando abrir uma empresa no Brasil parecia a pior das ideias, <strong>Mauro e Roseli Rinaldi</strong> abriram a Styllu's num quarto da casa da família, na Avenida Nossa Senhora do Ó. Pouco depois, <strong>Simone</strong> chegou trazendo a primeira máquina de escrever do escritório.
            </p>
            <p>
              Numa época em que tudo era escritório contábil, a ideia era outra: ser assessoria. Ir até o cliente, entender o negócio, atender de perto. O slogan nasceu junto com o nome e continua explicando tudo: <strong>um novo estilo de contabilidade</strong>.
            </p>
          </div>
        </div>

        <ol class="timeline">
          {milestones.map((m) => (
            <li class="timeline__item">
              <span class="timeline__year">{m.year}</span>
              <p>{m.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section-alt" id="equipe">
      <div class="container">
        <p class="eyebrow">Quem cuida do seu negócio</p>
        <h2 class="section-title">Pessoas reais. Relações reais.</h2>
        <p class="section-lead">
          Na Styllu's, cliente não fala com um número de protocolo. Fala com gente que conhece o nome da empresa, o histórico e o momento dela.
        </p>
        <div class="grid-2">
          {team.map((person) => (
            <article class="team-card">
              {person.photo ? (
                <img
                  class="team-avatar team-avatar--photo"
                  src={withBase(person.photo)}
                  alt={person.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="team-avatar">{person.initials}</div>
              )}
              <h3>{person.name}</h3>
              <p class="role">{person.role}</p>
              <p>{person.bio}</p>
            </article>
          ))}
        </div>
        <p class="section-note">
          E ainda há um time inteiro de analistas, assistentes e gestores por trás de cada entrega.
        </p>
      </div>
    </section>

    <section class="section" id="planos">
      <div class="container">
        <p class="eyebrow">Planos</p>
        <h2 class="section-title">Do tributário ao BPO, no tamanho da operação</h2>
        <p class="section-lead">
          Todos com analista dedicado, a partir de R$ 250,00. O valor final muda com a operação.
        </p>
        <ul class="price-factors" aria-label="O que muda o investimento">
          {priceFactors.map((factor) => <li>{factor}</li>)}
        </ul>
        <div class="grid-4 plans-grid">
          {plans.map((plan) => (
            <article class={`plan plan--${plan.name.toLowerCase()} ${plan.featured ? 'plan--featured' : ''}`}>
              <span class="plan__badge">{plan.badge}</span>
              <p class="plan__price plan__price--from">{plan.price}</p>
              <p class="plan__price-note">por mês</p>
              <h3 class="plan__title">
                <PlanIcon plan={plan.name} />
                {plan.name}
              </h3>
              <p class="plan__description">{plan.description}</p>
              <ul>
                {plan.items.map((item) => <li>{item}</li>)}
              </ul>
              <a
                class="btn btn-primary"
                href={`https://wa.me/5511925188621?text=${encodeURIComponent(`Olá! Quero falar com um especialista sobre o plano ${plan.name}.`)}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Falar com especialista
              </a>
            </article>
          ))}
        </div>

        <div class="grid-2">
          <div class="plan-quiz-intro">
            <h3>Não sabe qual plano faz sentido?</h3>
            <p>
              Responda algumas perguntas rápidas e a gente indica um caminho, sem custo e sem compromisso.
            </p>
            <p class="plan-quiz-note">
              <strong>O que muda o valor:</strong> regime, faturamento, funcionários, filiais, folha e BPO. O quiz indica um caminho. O especialista confirma.
            </p>
          </div>
          <PlanQuiz client:visible />
        </div>
      </div>
    </section>

    <section class="section section-alt" id="depoimentos">
      <div class="container">
        <p class="eyebrow">Depoimentos</p>
        <h2 class="section-title">O que nossos clientes dizem</h2>
        <p class="section-lead">
          O que os clientes escrevem sobre a Styllu's no Google.
        </p>
        <Testimonials client:visible />
      </div>
    </section>

    <section class="section" id="contato">
      <div class="container">
        <p class="eyebrow">O próximo passo é seu</p>
        <h2 class="section-title">Fale com um especialista</h2>
        <p class="section-lead">
          Conte regime, equipe e o que a empresa precisa. A partir daí, o plano e o investimento.
        </p>
        <div class="contact-grid">
          <div class="contact-info">
            <a class="btn btn-primary" href="https://wa.me/5511925188621?text=Ol%C3%A1!%20Quero%20falar%20com%20um%20especialista%20sobre%20a%20minha%20empresa." target="_blank" rel="noopener noreferrer">
              Falar com especialista
            </a>
            <div class="contact-item">
              <h3>Endereço</h3>
              <p>Rua da Bica, 55, Freguesia do Ó<br />São Paulo/SP, 02925-000</p>
            </div>
            <div class="contact-item">
              <h3>WhatsApp Comercial</h3>
              <p><a href="https://wa.me/5511925188621" target="_blank" rel="noopener noreferrer">(11) 92518-8621</a></p>
            </div>
            <div class="contact-item">
              <h3>Telefone Comercial</h3>
              <p><a href="tel:+551139333939">(11) 3933-3939</a></p>
            </div>
            <div class="contact-item">
              <h3>SAC (já sou cliente)</h3>
              <p><a href="tel:+5511910155687">(11) 91015-5687</a></p>
            </div>
            <div class="contact-item">
              <h3>E-mail</h3>
              <p><a href="mailto:contato@stylluscontabil.com.br">contato@stylluscontabil.com.br</a></p>
            </div>
          </div>
          <ContactForm client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

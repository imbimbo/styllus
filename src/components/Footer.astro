---
import { withBase } from '../lib/base';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href={withBase('')} style="color:#fff">
        <img src={withBase('styllu-logo.png')} alt="Styllu's" width="40" height="40" />
      </a>
      <p>Muito mais do que contabilidade, uma verdadeira assessoria.</p>
      <div class="footer-meta">
        <span>400+ clientes ativos</span>
        <span>35+ anos de experiência</span>
        <span>Atendimento nacional</span>
      </div>
    </div>

    <div class="footer-col">
      <h4>Institucional</h4>
      <ul>
        <li><a href={withBase('#sobre')}>Sobre</a></li>
        <li><a href={withBase('#diferenciais')}>Diferenciais</a></li>
        <li><a href={withBase('#equipe')}>Equipe</a></li>
        <li><a href={withBase('#depoimentos')}>Depoimentos</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Soluções</h4>
      <ul>
        <li><a href={withBase('#servicos')}>Tributário</a></li>
        <li><a href={withBase('#servicos')}>Trabalhista</a></li>
        <li><a href={withBase('#servicos')}>Contábil</a></li>
        <li><a href={withBase('#servicos')}>BPO Financeiro</a></li>
        <li><a href={withBase('#planos')}>Planos</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contato</h4>
      <ul>
        <li>São Paulo/SP, Rua da Bica, 55, Freguesia do Ó, 02925-000</li>
        <li><a href="https://wa.me/5511910155687" target="_blank" rel="noopener noreferrer">(11) 91015-5687 WhatsApp</a></li>
        <li><a href="tel:+551139333939">(11) 3933-3939 Comercial</a></li>
        <li><a href="mailto:contato@stylluscontabil.com.br">contato@stylluscontabil.com.br</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Styllu's Assessoria Contábil. Todos os direitos reservados.</p>
    <div style="display:flex; gap:1rem;">
      <a href={withBase('politica-privacidade')}>Política de Privacidade</a>
      <a href={withBase('termos-uso')}>Termos de Uso</a>
    </div>
    <p class="footer-credit">
      Desenvolvido por <a href="https://www.linkedin.com/company/i-tech-og/" target="_blank" rel="noopener noreferrer">I-Tech</a>
    </p>
  </div>
</footer>
